# Copy this file to .env and fill in real values. Never commit the real .env.

# PostgreSQL/TimescaleDB connection (see docker-compose.yml for the local default)
DATABASE_URL=postgresql://pipeline_user:pipeline_pass@localhost:5433/multi_asset_pipeline

# FX data source: Twelve Data free "Basic" tier (https://twelvedata.com/pricing).
# Not named in FRD Section 8.1's institutional-grade FX list (Refinitiv/LSEG, Bloomberg BPIPE,
# OANDA, Polygon.io) -- added here as the budget-free FX substitute, documented per the same
# transparency principle the FRD applies to the equities substitutes. Free tier = 800 requests/day,
# 8 requests/minute, delayed/EOD-quality data, "internal, non-display use only" license.
TWELVEDATA_API_KEY=

# Equities data source: Alpaca Market Data API, IEX feed -- this IS the budget-free substitute
# the FRD names explicitly in Section 8.1 ("Alpaca IEX feed (US equities only, single-venue,
# not consolidated tape)"). Free paper-trading account credentials work for market data.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Optional: POST a JSON payload here on feed downtime / malformed-payload / data-gap events.
# Leave blank to log-only (no outbound alert).
ALERT_WEBHOOK_URL=

LOG_LEVEL=INFO
